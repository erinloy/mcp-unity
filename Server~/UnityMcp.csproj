<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>unity-mcp</AssemblyName>
    <RootNamespace>McpUnity.DirectMcp</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Opt out of central package management -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- MCP SDK references replaced with project references to fork -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0-preview.7.25380.108" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0-preview.7.25380.108" />
  </ItemGroup>

  <!-- Reference the MCP SDK fork projects -->
  <ItemGroup>
    <ProjectReference Include="../../../../../../../REFERENCE/libraries/mcp-csharp-sdk/src/ModelContextProtocol.Core/ModelContextProtocol.Core.csproj" />
    <ProjectReference Include="../../../../../../../REFERENCE/libraries/mcp-csharp-sdk/src/ModelContextProtocol/ModelContextProtocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="UnityMcpConnector.cs" />
  </ItemGroup>

  <!-- Post-build event to build and deploy executable -->
  <Target Name="PostBuild" AfterTargets="Build" Condition="'$(SkipPostBuild)' != 'true'">
    <PropertyGroup>
      <!-- Detect if we're in a package cache deployment or source location -->
      <IsInPackageCache>false</IsInPackageCache>
      <IsInPackageCache Condition="$(MSBuildProjectDirectory.Contains('PackageCache'))">true</IsInPackageCache>
      
      <!-- Calculate Unity project root based on location -->
      <!-- From PackageCache: Server~ -> com.erinloy.mcp-unity@hash -> PackageCache -> Library -> [Unity Project Root] -->
      <UnityProjectRoot Condition="'$(IsInPackageCache)' == 'true'">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../../..'))</UnityProjectRoot>
      <UnityProjectRoot Condition="'$(IsInPackageCache)' != 'true'">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../..'))</UnityProjectRoot>
      
      <TargetExePath>$(UnityProjectRoot)/Tools/unity-mcp/unity-mcp.exe</TargetExePath>
      <TempPublishDir>$(MSBuildProjectDirectory)/bin/publish/</TempPublishDir>
    </PropertyGroup>
    
    <!-- Publish the project to create the executable (with flag to prevent recursion) -->
    <Exec Command="dotnet publish &quot;$(MSBuildProjectFile)&quot; -c Release -r win-x64 --self-contained -o &quot;$(TempPublishDir)&quot; -p:SkipPostBuild=true" />
    
    <!-- Kill any existing instances of unity-mcp.exe at the target location -->
    <Exec Command="powershell -Command &quot;$targetPath = '$(TargetExePath)'; if (Test-Path $targetPath) { Get-Process | Where-Object { $_.Path -eq $targetPath } | Stop-Process -Force -ErrorAction SilentlyContinue; Start-Sleep -Milliseconds 500 }&quot;" ContinueOnError="true" />
    
    <!-- Create Tools directory if it doesn't exist -->
    <MakeDir Directories="$(UnityProjectRoot)/Tools/unity-mcp" />
    
    <!-- Copy the executable to the predictable location -->
    <Copy SourceFiles="$(TempPublishDir)unity-mcp.exe" DestinationFiles="$(TargetExePath)" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
    
    <Message Text="Unity MCP executable deployed to: $(TargetExePath)" Importance="high" />
  </Target>

</Project>